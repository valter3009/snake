# MEXC API Configuration
MEXC_API_KEY=your_api_key_here
MEXC_API_SECRET=your_api_secret_here

# Bot Configuration
TRADING_MODE=simulation  # simulation or live
TRADING_PAIR=BTC/USDT
INITIAL_BALANCE=1000.0

# Strategy Parameters
RSI_PERIOD=14
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
MA_SHORT_PERIOD=20
MA_LONG_PERIOD=50

# Risk Management
MAX_POSITION_SIZE=0.1  # 10% of balance per trade
STOP_LOSS_PERCENT=2.0
TAKE_PROFIT_PERCENT=5.0

# Web Interface
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=True

# Database
DATABASE_PATH=bot/data/trades.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=bot/logs/bot.log
