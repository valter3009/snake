# Telegram Bot Configuration
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ID или username вашего Telegram канала
# Для публичного канала: @channel_username
# Для приватного канала: -1001234567890
TELEGRAM_CHANNEL_ID=@mynewschannel

# Telegram ID администратора (для модерации)
# Узнайте свой ID у @userinfobot
TELEGRAM_ADMIN_ID=123456789

# Claude API Key (Anthropic)
# Получите на https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# NewsAPI Key
# Получите на https://newsapi.org/
NEWS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL Database URL
# Для Railway автоматически устанавливается
# Локально: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/news_bot

# Примечания:
# 1. Скопируйте этот файл в .env и заполните реальными значениями
# 2. Никогда не коммитьте файл .env в репозиторий!
# 3. Убедитесь, что .env добавлен в .gitignore
# 4. Для Railway переменные устанавливаются в UI платформы
