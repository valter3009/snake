# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_ID=your_telegram_id_here
TELEGRAM_CHANNEL_ID=@InsightAlert

# Telegram Client API (для парсинга каналов)
# Получить здесь: https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+79001234567

# Claude AI
ANTHROPIC_API_KEY=sk-ant-api03-xxx

# Database
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Settings
TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO

# Publishing Schedule
MIN_POSTS_PER_DAY=40
MAX_POSTS_PER_DAY=50
PUBLISH_START_HOUR=7
PUBLISH_END_HOUR=23

# Content Settings
TOP_NEWS_COUNT=5
NEWS_MAX_AGE_HOURS=6
MIN_COLLECTION_INTERVAL=10
MAX_COLLECTION_INTERVAL=20
