# =============================================================================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ
# =============================================================================

# Telegram Bot (получить у @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHANNEL_ID=@your_channel_name

# Claude API (получить на https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# БАЗА ДАННЫХ
# =============================================================================

# Для локальной разработки (SQLite)
DATABASE_URL=sqlite:///./crypto_bot.db

# Для production (PostgreSQL на Railway - автоматически)
# DATABASE_URL предоставляется Railway автоматически, не нужно указывать вручную

# =============================================================================
# НАСТРОЙКИ ФИЛЬТРАЦИИ (можно не менять)
# =============================================================================

# Минимальная сумма транзакции кита для публикации (в USD)
MIN_WHALE_AMOUNT=5000000

# Минимальная капитализация проекта для листинга (в USD)
MIN_LISTING_MARKET_CAP=100000000

# Минимальная оценка важности события (0-10, рекомендуется >= 7)
MIN_IMPORTANCE_SCORE=7

# Минимальное изменение индекса страха/жадности для публикации
FEAR_GREED_MIN_CHANGE=10

# =============================================================================
# НАСТРОЙКИ AI ГЕНЕРАЦИИ (можно не менять)
# =============================================================================

# Модель Claude для генерации контента
CLAUDE_MODEL=claude-sonnet-4-20250514

# Максимум токенов в ответе
CLAUDE_MAX_TOKENS=1200

# Температура генерации (0.0-1.0, выше = креативнее)
CLAUDE_TEMPERATURE=0.7

# =============================================================================
# ИНТЕРВАЛЫ ПРОВЕРОК (в минутах)
# =============================================================================

# Как часто проверять движения китов
WHALE_CHECK_INTERVAL=10

# Как часто проверять новые листинги
LISTINGS_CHECK_INTERVAL=15

# Как часто проверять индекс страха/жадности
FEAR_GREED_CHECK_INTERVAL=60

# Как часто проверять airdrop'ы
AIRDROP_CHECK_INTERVAL=360

# Как часто проверять новости
NEWS_CHECK_INTERVAL=30

# Время публикации рыночных обзоров (UTC, через запятую)
MARKET_OVERVIEW_TIMES=08:00,20:00

# =============================================================================
# ЛИМИТЫ ПУБЛИКАЦИЙ
# =============================================================================

# Максимум сообщений в час
MAX_MESSAGES_PER_HOUR=3

# Максимум сообщений в день
MAX_MESSAGES_PER_DAY=12

# Минимальный интервал между сообщениями (в секундах)
MIN_INTERVAL_SECONDS=600

# =============================================================================
# ЛОГИРОВАНИЕ
# =============================================================================

# Уровень логов (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Директория для логов
LOG_DIR=./logs

# =============================================================================
# ОБЩИЕ НАСТРОЙКИ
# =============================================================================

# Окружение (development, production)
ENVIRONMENT=development

# Режим отладки (True/False)
DEBUG=False
