# Telegram Bot Configuration
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ID или username вашего Telegram канала
# Для публичного канала: @channel_username
# Для приватного канала: -1001234567890
TELEGRAM_CHANNEL_ID=@mynewschannel

# Claude API Key
# Получите на https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Примечания:
# 1. Скопируйте этот файл в .env и заполните реальными значениями
# 2. Никогда не коммитьте файл .env в репозиторий!
# 3. Убедитесь, что .env добавлен в .gitignore
